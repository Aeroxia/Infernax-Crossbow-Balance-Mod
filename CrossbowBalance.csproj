<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>CrossbowBalance</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Where the game lives (default: this folder is <game>\!Etc\CrossbowBalance).
         Override with: dotnet build -c Release -p:GameDir="C:\path\to\Infernax\"
         References come from BepInEx's generated interop + core folders (run the game once with BepInEx first). -->
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)..\..\</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameDir)BepInEx\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDir)BepInEx\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GameDir)BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)BepInEx\core\Il2CppInterop.Runtime.dll" Private="false" />
    <!-- All generated game/Unity interop assemblies -->
    <Reference Include="$(GameDir)BepInEx\interop\*.dll" Private="false" />
  </ItemGroup>
  <!-- After building, drop the dll straight into the plugins folder -->
  <Target Name="CopyToPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)BepInEx\plugins" />
  </Target>
</Project>
